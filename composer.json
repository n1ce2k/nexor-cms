{
    "name": "n1ce2k/nexor-cms",
    "description": "NEXOR CMS — админ-панель для Laravel с инфоблоками, свойствами произвольных типов и системой ролей.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cms", "admin", "infoblocks", "nexor"],
    "authors": [
        {
            "name": "n1ce",
            "email": "andrew.n1ce2k@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Nexor\\Cms\\": "src/",
            "Nexor\\Cms\\Database\\Factories\\": "database/factories/",
            "Nexor\\Cms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexor\\Cms\\NexorServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
